# fly.toml.example - reference for the documented Fly.io target.
# DO NOT DEPLOY from this repo. Copy to fly.toml only after the owner
# approves the host, region (iad) and ~$3.84/30d spend. See docs/RUNBOOK.md.

app = "pal"          # choose; becomes FLY_APP_NAME
primary_region = "iad"

[build]

[env]
  # Fly edge proxy terminates TLS and forwards here; FLY_APP_NAME (set by
  # Fly) is what permits this non-loopback bind. See docs/SECURITY.md.
  PA_BIND = "0.0.0.0"
  PA_PORT = "8080"

[[mounts]]
  source = "pa_data"
  destination = "/data"

[http_service]
  internal_port = 8080
  force_https = true
  auto_stop_machines = "off"
  auto_start_machines = true
  min_machines_running = 1

[[vm]]
  size = "shared-cpu-1x"
  memory = "512mb"
