# Copy to .env and fill in. Secrets come ONLY from the environment or the
# host's secret store (e.g. `fly secrets set`). Never commit real values.

# development | test | production
PA_ENV=production

# Where SQLite and backups live (mount a volume here in production)
PA_DATA_DIR=/data

# Bind. Development: loopback only. Production: see docs/SECURITY.md -
# non-loopback is allowed only in the documented Fly topology, inside a
# container with PA_CONTAINER_BIND=true (publish rules = the boundary;
# compose publishes to host loopback only), or keep loopback behind a TLS
# terminator like Caddy.
PA_BIND=127.0.0.1
PA_PORT=8080
# PA_CONTAINER_BIND=true    # only inside Docker/compose deployments

# Scheduler default timezone (IANA name; per-schedule override exists)
PA_TIMEZONE=Europe/London

# --- Inference provider (owner-supplied OpenAI-compatible endpoint) -----
# Any OpenAI-compatible /chat/completions endpoint you control or pay for.
# https to any host, or http to loopback/private hosts only.
# LLM_API_KEY is optional ONLY for genuinely anonymous endpoints.
# Example: Groq  -> LLM_BASE_URL=https://api.groq.com/openai/v1
# Example: local -> LLM_BASE_URL=http://127.0.0.1:11434/v1 (no key needed)
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_STREAMING=false     # SSE streaming on/off
LLM_TOOLS=true          # set false for endpoints without tool calling

# --- Discord interface --------------------------------------------------
# Gateway bot. Disabled cleanly while the token is unset.
DISCORD_ENABLED=true
DISCORD_BOT_TOKEN=
# The ONE user allowed to drive the bot (fail closed for everyone else;
# when unset, everyone is refused).
DISCORD_OWNER_ID=
# Per-assistant result channel routing: JSON {name-or-id: channel-id}
# DISCORD_CHANNELS={"email": "1234567890", "default": "1234567891"}
# Optional guild channel where plain owner messages are treated as chat
# (DMs and @mentions always count as chat):
# DISCORD_CHAT_CHANNEL_ID=

# --- Conversational chat agent -------------------------------------------
# Assistant (by name) whose provider pin drives chat. The freebuff-cli pin
# gives the owner-LLM agent session; any OpenAI-compatible pin works too.
# PA_CHAT_ASSISTANT=pal
# PA_CHAT_MAX_STEPS=8            # ReAct tool steps per turn
# PA_CHAT_TURN_SECONDS=300       # overall turn deadline
# PA_CHAT_HISTORY_TURNS=8        # kept turns; older ones are summarised
# PA_CHAT_WORKING_SECONDS=8      # delay before the "working on it" note
# PA_CHAT_PROGRESS=true          # live turn progress: 👀 reaction + one
#                                # editable "on it — <tool>…" status line,
#                                # torn down when the reply lands. False =
#                                # typing + a single "working on it" note.
# PA_CHAT_APPROVAL_WAIT=3600     # how long a turn waits on a button click
# PA_ATTACH_MAX_BYTES=8388608    # inbound image/PDF download cap
# PA_PDF_MAX_PAGES=20            # pypdf extraction caps for DM'd PDFs
# PA_PDF_MAX_CHARS=50000
# PA_VISION=true                 # image captions for DM'd images + the
#                                # `look` tool; effectively off unless a
#                                # backend key exists (GROQ_API_KEY /
#                                # GEMINI_API_KEY / CLOUDFLARE_*)
# PA_VISION_ORDER=groq,gemini,cloudflare
# PA_VISION_MODEL_GROQ=          # override the built-in candidate list
# PA_VISION_MODEL_GEMINI=
# PA_VISION_MODEL_CLOUDFLARE=
# PA_VISION_MAX_BYTES=4194304    # images over this get no caption
# PA_VIDEO=false                 # video_look: sample+caption frames
# PA_VIDEO_MAX_MB=50             # (needs ffmpeg + a vision backend)
# PA_MEMORY_SAVE_APPROVAL=false  # also gate per-assistant memory_save
# PA_MEMORY_AUTO_PROPOSE=false   # end-of-turn fast pass may PROPOSE up to
# PA_MEMORY_PROPOSE_MAX=3        # owner_facts as approval cards (never
#                                # auto-writes the profile)
# PA_CHAT_SANDBOX=               # shell sandbox dir (default <data>/chat-sandbox)
# PA_SHELL_TIMEOUT=15  PA_SHELL_OUTPUT_CAP=8000

# --- Freebuff agent-session provider --------------------------------------
# Official CLI on this machine (chat/task brains drive it via tmux PTY).
# PA_FREEBUFF_ENABLED=true
# Serve it to a remote PA instead: `python -m pa freebuff-sidecar`
# PA_FREEBUFF_SIDECAR_HOST=127.0.0.1  PA_FREEBUFF_SIDECAR_PORT=8777
# On the REMOTE PA, point at the sidecar (shared bearer token):
# PA_FREEBUFF_REMOTE_URL=http://<home>:8777
# PA_FREEBUFF_REMOTE_TOKEN=
# PA_FREEBUFF_ASSUME_READY=false  PA_FREEBUFF_LIVE_CHECK=false

# --- Free-API router ("mini Freebuff") -------------------------------------
# Failover across free-tier LLM APIs + optional official-CLI sidecars.
# Enable, then pin an assistant to provider_host='router' (see
# docs/ROUTER.md). Empty keys are fine — that backend just reads
# "needs config" and is never called.
# PA_ROUTER_ENABLED=true
# PA_ROUTER_ORDER=                  # CSV backend names, both tiers
# PA_ROUTER_SMART_ORDER=            # smart = tool/agent steps
# PA_ROUTER_FAST_ORDER=             # fast  = plain chat / summaries
# PA_ROUTER_SMART_MODELS=           # CSV name=model overrides
# PA_ROUTER_FAST_MODELS=
# PA_ROUTER_CALL_SECONDS=180        # whole-call deadline
# PA_ROUTER_BACKEND_SECONDS=60      # per-attempt cap
# PA_ROUTER_CAP_<BACKEND>_<RPM|TPM|RPD|TPD>=   # e.g. PA_ROUTER_CAP_GROQ_RPD=900
# PA_ROUTER_ESCALATE=false          # 'think harder' tier (docs/EVOLVE.md #15)
# PA_ROUTER_ESCALATE_ORDER=         # CSV; defaults to the documented order
# PA_ROUTER_ESCALATE_RPD=20         # escalate calls/day cap
#
# API keys (only the ones you sign up for):
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# POLLINATIONS_API_KEY=   # optional — pollinations works keyless
# CEREBRAS_API_KEY=       # opt-in only: payment-gated trial, see ROUTER.md
# MISTRAL_API_KEY=        # opt-in only: no free API tier as of 2026-11
#
# Official-CLI session sidecars (loopback + bearer; the token is a
# shared secret YOU choose for router<->sidecar auth, not a provider key):
# PA_GEMINI_CLI_TOKEN=
# PA_GEMINI_CLI_URL=http://127.0.0.1:8781
# PA_GEMINI_CLI_BIN=agy           # Antigravity CLI (or 'gemini' w/ Code Assist)
# PA_COPILOT_CLI_TOKEN=
# PA_COPILOT_CLI_URL=http://127.0.0.1:8782
# PA_COPILOT_CLI_BIN=copilot
# Serve each with: python -m pa cli-sidecar <gemini|copilot>
# systemd user units: deploy/cli-sidecars/

# --- Gmail (read + draft + send) ------------------------------------------
# From `python -m pa gmail-auth` (one-time, on any machine with a browser)
# — or just `/connect google` in Discord (see Connections below), which
# stores the grant sealed in the DB instead of these env vars.
# Requests gmail.readonly + gmail.compose + gmail.send + calendar.events;
# sending still requires an explicit approval click.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Or put the token JSON in a chmod-600 file instead:
# GMAIL_TOKEN_FILE=/data/secrets/gmail-token.json
# GCAL_API_BASE=https://www.googleapis.com   # calendar API override

# --- Connections library (/connect <app> in Discord) -----------------------
# Full guide: docs/CONNECTIONS.md. Owner runs /connect notion|linear|google|
# url:https://... in Discord, signs in at the link, tools show up in chat.
#
# Encrypts every token blob at rest (AES-256-GCM). REQUIRED for /connect.
# Generate once with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Never committed, never logged; losing it means reconnecting every app.
PA_SECRETS_KEY=
# Public https base that OAuth providers redirect to — expose the web
# server with a free Cloudflare Tunnel (exact commands in
# docs/CONNECTIONS.md) and set the tunnel URL here. The callback is
# <PA_PUBLIC_URL>/oauth/callback — add exactly that as the redirect URI
# on OAuth apps you register yourself.
PA_PUBLIC_URL=
# Google OAuth client for `/connect google` (Gmail+Calendar). Falls back
# to the GMAIL_CLIENT_* pair above when unset — same client.
# PA_GOOGLE_CLIENT_ID=
# PA_GOOGLE_CLIENT_SECRET=
# GitHub's auth server has no dynamic client registration — register an
# OAuth App by hand (redirect URI = the callback above) for /connect github.
# PA_GITHUB_CLIENT_ID=
# PA_GITHUB_CLIENT_SECRET=
# Optional: Composio managed-auth fallback for apps not in the catalog.
# Free Hobby platform tier ~= 20k managed-app calls/month; a local counter
# warns you in Discord at 80%. Override the assumed cap if pricing changes:
# COMPOSIO_API_KEY=
# PA_COMPOSIO_MONTHLY_LIMIT=20000
# PA_MCP_TIMEOUT=20        # per-request seconds for MCP/OAuth calls
# Multiple accounts per app: `/connect gmail` is the owner's (default)
# account; `/connect gmail account:pal` connects a second, labelled one —
# its tools are addressed 'gmail@pal.<tool>'.
# The owner's own email address — where pal's mailbox sends digests.
# REQUIRED for the email_owner chat tool (the only send that needs no
# approval — the recipient can only ever be this address).
# PA_OWNER_EMAIL=owner@example.com

# --- Voice: TTS + voice notes + Discord calls (docs/VOICE.md) --------------
# Needs ffmpeg + libopus on the host: `sudo apt install ffmpeg libopus0`.
# Voice notes out: native Discord voice messages (chat replies include one
# when enabled — owner toggles it live with /voice on|off|auto; 'auto'
# speaks replies only while the owner is busy, and is the default).
# PA_VOICE_NOTES=false                 # default before the first /voice
#
# TTS provider chain — order via PA_TTS_ORDER (any subset of
# gemini,fish,azure,cloudflare); a provider with no key is skipped, an
# erroring one cools down and the next is tried.
# PA_TTS_ORDER=gemini,fish,azure,cloudflare
#
# 1) Gemini TTS — reuses GEMINI_API_KEY above.
# PA_TTS_GEMINI_MODEL=gemini-3.8-flash-tts   PA_TTS_GEMINI_VOICE=Kore
# 2) Fish Audio — free s2.1-pro-free until 2026-11-30 (docs.fish.audio).
# FISH_API_KEY=     PA_TTS_FISH_MODEL=s2.1-pro-free
# PA_TTS_FISH_VOICE=   # optional reference-id for a cloned voice
# 3) Azure Speech — F0 free tier (needs BOTH key + region).
# AZURE_SPEECH_KEY=   AZURE_SPEECH_REGION=uksouth
# PA_TTS_AZURE_VOICE=en-GB-SoniaNeural
# 4) Cloudflare Workers AI @cf/deepgram/aura-2-en — reuses the
#    CLOUDFLARE_* pair above. PA_TTS_CF_SPEAKER=luna
# CLOUDFLARE_AI_BASE=https://api.cloudflare.com/client/v4
# PA_FFMPEG=ffmpeg
#
# Voice notes IN: owner audio attachments are transcribed via Groq
# whisper-large-v3-turbo (reuses GROQ_API_KEY), Cloudflare
# @cf/openai/whisper-large-v3-turbo fallback. Reply = text + voice note.
# GROQ_WHISPER_BASE=https://api.groq.com/openai/v1
# PA_WHISPER_MODEL=whisper-large-v3-turbo
# PA_CF_WHISPER_MODEL=@cf/openai/whisper-large-v3-turbo
#
# Calls (call_owner tool, /call test): pal rings the owner in a private
# guild voice channel — bot needs Connect+Speak (+Manage Channels when
# PA_CALL_CHANNEL_ID is unset so it can create 'pal-call').
# PA_CALL_GUILD_ID=          # guild pal calls in (required for calls)
# PA_CALL_CHANNEL_ID=        # voice channel; unset -> find/create 'pal-call'
# PA_CALL_MAX_PER_HOUR=3     PA_CALL_JOIN_SECONDS=120
# PA_CALL_LISTEN_SECONDS=30  PA_CALL_MAX_SECONDS=600
# PA_QUIET_HOURS=23-07       # local HH-HH; only urgent calls ring inside
# PA_CALL_METRICS=true       # per-turn timing rows (/call stats)
# PA_CALL_AUDIO=inproc       # inproc = gapless in-process playback
#                            # (one AudioSource/call, no ffmpeg at play
#                            # time); ffmpeg = legacy per-clip spawn
# PA_CALL_TAIL_MS=500        PA_CALL_TAIL_SHORT_MS=700
#                            # end-of-speech tails (normal / after a
#                            # short burst — shorter = snappier)
# PA_CALL_ENGINE=auto        # auto = Gemini Live first, pipeline
#                            # fallback; live = Live only; pipeline =
#                            # STT->LLM->TTS only
# PA_LIVE_MODEL=gemini-3.1-flash-live-preview
# PA_LIVE_VOICE=Kore         # Live prebuilt voice
# PA_LIVE_BUDGET=false       # reserve+charge live_min under call scope
#
# Jarvis (docs/JARVIS.md) — all opt-in, defaults shown:
# PA_WATCH_MAX_CLASSIFY=20             # watcher model calls per 15-min run
# PA_WATCH_MAX_CALLS_PER_DAY=5         # watcher-triggered calls/day cap
# PA_WATCH_IMPORTANT_BATCH_SECONDS=3600
# PA_OPEN_METEO_BASE=https://api.open-meteo.com
# PA_BRIEFING_CITY=London  PA_BRIEFING_LAT=51.5074  PA_BRIEFING_LON=-0.1278
# PA_IMPORT_MAX_BYTES=62914560         # DM attachment cap for chat-history imports
#
# Calls need the voice extras on the host (NOT in base requirements):
#   pip install -r requirements-voice.txt   # discord.py[voice], davey,
#                                           # discord-ext-voice-recv, PyNaCl
# Bot must also be re-invited with the guild_voice_states intent ticked —
# invite URL in docs/VOICE.md.

# --- Obsidian vault mirror -------------------------------------------------
# Path to a synced Markdown mirror ON THE HOST. Chat can append/write
# notes (overwrite needs approval); optionally git-sync the mirror after
# each write.
VAULT_PATH=
# VAULT_MAX_FILE_BYTES=262144  VAULT_MAX_FILES=5000  VAULT_NOTE_CAP=12000
# VAULT_GIT_SYNC=false   # true -> git add/commit/push after each write

# --- Owner Mac over SSH (Tailscale) ----------------------------------------
# Lets the `mac` chat tool run commands on the owner's Mac. EVERY mac
# command requires approval. Unreachable -> "the Mac is offline".
# MAC_SSH_HOST=mac-mini.tail-scale.ts.net
# MAC_SSH_USER=your-mac-user
# MAC_SSH_KEY=/data/secrets/id_ed25519
# MAC_SSH_TIMEOUT=20

# --- Web search ------------------------------------------------------------
# Tavily when both are set; otherwise chat falls back to keyless
# DuckDuckGo HTML (rate-limited, best-effort). Off for tasks when unset.
SEARCH_ENABLED=false
TAVILY_API_KEY=
# DDG_SEARCH_BASE=https://html.duckduckgo.com

# --- Development-only provider fallback (never in production) ------------
# PA_OLLAMA_BASE_URL=http://localhost:11434/v1
# PA_DEV_MODEL=qwen2.5:1.5b

# --- Quota pacing (tune to your endpoint's limits) ------------------------
# PA_MAX_INPUT_TOKENS=5500
# PA_MAX_COMPLETION_TOKENS=1024
# PA_TPM_LIMIT=8000
# PA_RPM_LIMIT=30
# PA_DAILY_REQUEST_LIMIT=1000
# PA_DAILY_TOKEN_LIMIT=200000
# PA_RATE_MAX_RETRIES=3

# --- Backups --------------------------------------------------------------
# PA_BACKUP_DEST=/path/you/choose/export.bin
# PA_BACKUP_PASSPHRASE=        (prefer interactive prompt)
# PA_BACKUP_KEEP=7             # scheduled-backup: keep newest N exports
                               # (/jobs scheduled-backup on)

# --- Telegram mirror (docs/PARITY.md #26) — off by default ---------
# PA_TELEGRAM=false            # mirror + answer the owner's bot chat
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=            # the owner's own chat id with the bot

# --- pal's computer: persistent Chromium + /desktop (docs/COMPUTER.md) ---
# Off by default. Best on a second Always Free Ampere A1 VM reached
# over Tailscale; same-VM fallback is on-demand + cgroup-capped.
# PA_COMPUTER_ENABLED=false
# PA_COMPUTER_PROFILE=              # default <data>/browser-profile, chmod 700
# PA_COMPUTER_MAX_TABS=3            # hard tab cap
# PA_COMPUTER_IDLE_SECONDS=300      # idle-exit; profile stays on disk
# PA_COMPUTER_MEMORY_MB=600         # self-check recycle; cgroup is the real cap
# PA_COMPUTER_LOCK_WAIT=30          # seconds a 2nd caller waits on the lock
# Remote computer-agent (pal is the CLIENT when PA_COMPUTER_URL is set;
# http allowed only to loopback/private/100.64/10, https anywhere):
# PA_COMPUTER_URL=                  # e.g. http://100.64.1.5:8788
# PA_COMPUTER_TOKEN=                # shared bearer secret YOU choose
# On the computer host (`python -m pa computer-agent`) — loopback or
# 100.64/10 bind only, never 0.0.0.0:
# PA_COMPUTER_AGENT_BIND=127.0.0.1
# PA_COMPUTER_AGENT_PORT=8788
# PA_COMPUTER_DOWNLOAD_MAX=20971520 # download cap, into the chat sandbox
# PA_COMPUTER_BROWSER_BIN=          # chromium path override (else PATH/cache)
# PA_DESKTOP_MINUTES=30             # /desktop TTL; hard cap 120
# PA_DESKTOP_PORT=6080              # noVNC port on the tailnet bind
# PA_JINA_READER=                   # read_url's r.jina.ai fallback; default
#                                   # on when the computer is on
# JINA_API_KEY=                     # optional — raises jina's ~20 req/min cap

# --- pal evolve: self-improvement loop (docs/EVOLVE.md) — all off ------
# Incidents are recorded whenever the table exists; the flags below
# only decide whether pal ACTS on them. Each stage has its own gate.
# PA_EVOLVE=false                  # master switch for detect/reflect/etc
# PA_EVOLVE_AUTO_APPLY=false       # Track A: auto-apply LOW-risk items
# PA_EVOLVE_SELF_HEAL=false        # queue approval-gated fix code_tasks
# PA_EVOLVE_PLAN_CALLS=10          # max planner model calls per day
# PA_EVOLVE_REFLECT_MAX=3          # max lesson/skill items per night
# PA_EVOLVE_DETECT_THRESHOLD=3     # fingerprint hits in 24h -> an item
# PA_EVOLVE_DETECT_MAX_ITEMS=3     # new items opened per detect run
# PA_EVOLVE_HEALTH_SECONDS=60      # canary health window after deploy
# PA_EVOLVE_ARCHIVE=false          # final-4: versioned improvement
#                                  # archive — every skill/snippet/
#                                  # config/made-tool/memory-block
#                                  # change becomes a scored variant;
#                                  # Track A promotes only >= live on
#                                  # the pinned evaluator; anti-gaming
#                                  # rejects score-jumps/protected
#                                  # paths/weakened assertions
#                                  # (docs/FINAL-4.md)
# PA_EVOLVE_PRACTICE=false         # final-4: nightly owner-approved
#                                  # self-practice -> skill candidates
# PA_BACKUP_OFFSITE=               # final-4: 'gdrive@pal' copies each
#                                  # encrypted backup to pal's own
#                                  # Google Drive (off-box copy)

# --- deep /healthz (docs/EVOLVE.md item 3) ------------------------------
# PA_HEALTH_RSS_MB=700             # RSS ceiling for ok=true
# PA_HEALTH_EXPECT_WORKER=false    # also require a fresh worker beat
# PA_HEALTH_WORKER_MAX_SECONDS=120 # beat staleness limit
# PA_HEALTH_DISCORD=false          # also require a live in-process
#                                  # Discord gateway (pa serve)

# V5 call brain: streamed tiny model on the router 'call' tier
# (default order groq -> gemini-api -> openrouter-free -> cloudflare,
# api backends only, 4s per attempt). PA_CALL_STREAM_BRAIN=off restores
# the full chat-agent turn; PA_CALL_LLM_SECONDS tunes the per-backend cap.
# PA_CALL_STREAM_BRAIN=on
# PA_ROUTER_CALL_ORDER=
# PA_ROUTER_CALL_MODELS=
# PA_CALL_LLM_SECONDS=4

# V7 call TTS budgets: daily char caps per provider; a spent provider
# is skipped before the call locks a voice. PA_TTS_CHARS_DAY sets one
# global cap; PA_TTS_CHARS_<PROVIDER>_DAY overrides per provider.
# PA_TTS_CHARS_DAY=0
# PA_TTS_CHARS_AZURE_DAY=0
# PA_TTS_CHARS_CLOUDFLARE_DAY=0
# PA_TTS_CHARS_GEMINI_DAY=0

# V8: python -m pa call-bench [n] [live|pipeline] — owner-run latency
# benchmark; writes call_metrics rows with engine='bench'. No flags.

# P1 account-owner registry: browser domains whose signed-in account
# is pal's (unknown domains fail closed to owner). Connections get
# owner_kind via the /connect 'whose account?' button.
# PA_BROWSER_OWNER_DOMAINS=pal.example=pal

# P2-P5 policy engine: ONE approval floor across every action path.
# PA_POLICY_ENGINE=on (default) — writes/sends/deletes/spends/
# settings/publishes on the OWNER's accounts always need an explicit
# Discord approval; allow rules and unattended runs cannot cover
# them. 'off' restores the legacy per-tool gates (emergency only).
# PA_POLICY_VAULT_UNATTENDED keeps vault writes unattended-free.
# PA_POLICY_ENGINE=on
# PA_POLICY_VAULT_UNATTENDED=true

# B1-B3 budgets: daily ledger (day Europe/London) by scope
# (owner-chat | call | background | job:<n> | task:<id>) and resource.
# Defaults: background <= 30% of each daily quota, calls reserve 20%
# of TTS/STT/Live. Override any cap:
# PA_BUDGET_<RESOURCE>_<SCOPE>=<n>    e.g. PA_BUDGET_ESCALATIONS_BACKGROUND=8

# L1 lean tool catalogue: prune the ReAct tool list to a core set +
# top-k keyword matches per turn; tools_more lists the rest.
# PA_TOOL_TOPK=16

# --- goals, proactive read-only work, memory OS, triage --------------
# All OFF by default; background work is read-only on the owner's
# accounts — writes can only come back as approval cards.
# See docs/FEATURES.md.
# PA_GOALS=false           # standing goals: goal_* tools + /goals
# PA_PROACTIVE=false       # proactive-tick job (hourly, quiet-aware)
# PA_PROACTIVE_GOAL_TOKENS=8000   # per-goal token cap per tick
# PA_ACTIVITY=false        # local activity feed + /activity
# PA_ACTIVITY_GREETING=false      # "while you were away" DM preamble
# PA_AUTOMATION=false      # automation_propose tool (monitor/schedule/webhook)
# PA_BRIEFING_GOALS=false  # Goals section in the morning briefing
# PA_MEMORY_BLOCKS=false   # pinned persona/human/goals/world blocks
# PA_SLEEPTIME=false       # nightly memory curation pass
# PA_RECALL=false          # one FTS5 index across memory/vault/journal
# PA_KG=false              # personal knowledge graph over the vault
# PA_TRIAGE=false          # inbox triage labels + local reply drafts
# PA_CAL_TRIAGE=false      # 30-min meeting prep + conflict cards
# PA_CAL_SOON=false        # cheap "meeting in 15m/5m" ping via notify()
# PA_CAL_SOON_LEADS=15,5   # lead minutes for the meeting-soon ping
# PA_LEAVE_NOW=false       # TfL "leave in 10m / leave now" for events
                          # with a location (same cal-triage tick)
# PA_HOME_LAT= PA_HOME_LON=# leave-from origin (default: briefing city)
# PA_LEAVE_NOW_USE_PHONE_LOC=false
                          # may reuse a fresh phone-node location fix
# TFL_APP_KEY=             # optional; keyless TfL works at low volume
# PA_GITHUB_HOOK_AGENT=false # github/ci webhook payloads run an agent
                          # turn (off: CI/PR events -> DM cards only)
# PA_COURSEWORK=false      # Classroom/Docs reads + hourly deadline
                          # watch (needs a connected Composio toolkit)
# PA_NOTION_INDEX=false    # Notion -> recall/KG index, read-only,
                          # ~25 pages a tick (needs a notion conn)
# PA_SECRET_CAPTURE=true   # credentials via private modal/one-time
                          # https form; OFF restores the insecure
                          # text-args path — leave it on
# PA_NOTIFY_PHONE=false    # high/urgent notify() also pings a healthy
                          # phone node (notify cap; vibrate for urgent
                          # when allowed)
# PA_MAIL_INBOUND=false    # poll pal's own Gmail for owner messages
                          # -> owner chat turns (mail-inbound sysjob)
# PA_OWNER_EMAIL=          # the owner's From: for the allowlist
# PA_MAIL_INBOUND_SENDERS= # extra allowed senders, csv
# PA_NOTIFY_V2=false       # priority/quiet/batched notifications
# PA_NOTIFY_PER_HOUR=6     # DM cap per hour (held -> morning batch)
# PA_PROJECTS=false        # goal-linked multi-day projects

# X1 nodes (docs/NODES.md): pal's remote hands. PA_NODES is a CSV of
# name=url entries (same URL rules as PA_COMPUTER_URL: http only to
# loopback/tailnet/private, https otherwise, no credentials). Each
# node needs a shared bearer in PA_NODE_<NAME>_TOKEN — never commit it.
# PA_NODES=phone=http://127.0.0.1:8791
# PA_NODE_PHONE_TOKEN=
# PA_NODE_CONNECT_SECONDS=10
# PA_NODE_HEALTH_SECONDS=30

# X3 phone node (docs/PHONE.md): phone_* chat tools appear once a
# 'phone' node is configured via PA_NODES. Unattended job turns may
# not read the owner's SMS inbox unless this is explicitly on —
# attended chat reads are always fine.
# PA_NODE_SMS_READ_UNATTENDED=false

# W1 file workspace (docs/WORKSPACE.md): durable per-project files
# with versions under <PA_DATA_DIR>/workspace/. Off by default —
# file_write keeps its attach-only behaviour; on, file_list/read/
# version/delete appear and file_write also persists.
# PA_WORKSPACE=false
# PA_WORKSPACE_MB=500
# PA_WORKSPACE_PROJECT=main

# K1 tool making (docs/TOOLMAKING.md): pal writes+tests+registers
# small pure-Python tools under <PA_DATA_DIR>/tools/. Off by default —
# tool_make/tool_run/tool_list stay hidden.
# PA_MADETOOLS=false

# K2 integration builder (docs/TOOLMAKING.md): pal generates small
# API clients (K1 tools + a 'made' connection row; keys sealed in the
# vault, injected at run time, never in code). Needs PA_MADETOOLS=1.
# PA_INTEGRATIONS=false

# S1 budgeted sub-agents (docs/SUBAGENTS.md): the delegate chat tool
# spawns bounded role tasks (researcher/analyst/browser/coder) through
# the worker. Off by default — delegate falls back to a queued inbox
# turn. PA_SUBAGENT_MAX caps live children.
# PA_SUBAGENTS=false
# PA_SUBAGENT_MAX=2

# S2 research reports (docs/RESEARCH.md): the research chat tool runs
# a cited-report sub-agent (needs PA_SUBAGENTS) and writes the result
# to the workspace. Off by default.
# PA_RESEARCH=false

# K3 skill extraction (docs/TOOLMAKING.md): after a clean ok turn with
# >=3 tool steps, propose a reusable skill — queued as a held
# skill_save for the owner; also marks the top-3 relevant skills in
# the system prompt. Off by default.
# PA_SKILLEXTRACT=false
